# Copy to .env and fill in. NEVER commit .env.
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
# In production, list your real domain(s), e.g. ALLOWED_HOSTS=nyota.onrender.com,www.nyota.market
# CSRF_TRUSTED_ORIGINS needs the full https:// origin(s), comma-separated, e.g.:
# CSRF_TRUSTED_ORIGINS=https://nyota.onrender.com,https://www.nyota.market
CSRF_TRUSTED_ORIGINS=
SITE_URL=http://localhost:8000
COMPANY_NAME=Nyota
COMPANY_DOMAIN=nyota.market
# Leave empty for SQLite; use Postgres in production. Supabase: Project Settings > Database >
# Connection string. This app keeps a long-running process (Daphne + a Celery worker), not a burst
# of short-lived serverless calls, so use the "Session pooler" or "Direct connection" string (NOT
# "Transaction pooler" -- that one is meant for serverless functions). Add ?sslmode=require.
# DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
# Optional: Redis gives multi-process live chat + a real Celery worker
# REDIS_URL=redis://localhost:6379/0

# Email (console printing when EMAIL_HOST is empty)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# Sign in with Google / GitHub / Microsoft (customers). Redirect URI: {SITE_URL}/oauth/<provider>/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# M-Pesa Daraja (sandbox by default). MPESA_CALLBACK_URL must be a public https URL.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# With no payment keys the site runs payments in DEMO mode (no real money).
# PAYMENTS_SIMULATE=True
PLATFORM_COMMISSION_PERCENT=8
SHOP_AUTO_APPROVE=True

# Members-only: visitors must sign in or sign up before seeing the shop, using the cart or paying.
# Set False to open the storefront to everyone.
MEMBERS_ONLY=True
